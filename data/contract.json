      "provenanceTags",
      "markers",
      "menu"
    ],
    "skills/prompt-engine/references/questions.md": [
      "replyLine"
    ],
    "skills/prompt-engine/SKILL.md": [
      "headings",
      "scoreDimensions",
      "provenanceTags",
      "markers",
      "replyLine",
      "menu"
    ],
    "universal/prompt-engine.md": [
      "headings",
      "scoreDimensions",
      "scoreCaveat",
      "provenanceTags",
      "markers",
      "replyLine",
      "menu"
    ]
  },
  "budgets": {
    "skillBodyMaxChars": 18000,
    "skillBodyMaxLines": 500,
    "skillKeySectionsWithinChars": 8000,
    "skillKeySections": [
      "### 1. Intake",
      "### 3. Ask",
      "### 5. Present"
