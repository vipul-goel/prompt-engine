      "Clear goal",
      "Context",
      "Constraints",
      "Output format",
      "Edge cases"
    ],
    "scoreCaveat": [
      "Self-assessed coverage of five areas, not a prediction of output quality."
    ],
    "provenanceTags": [
      "[you]",
      "[your answer]",
      "[best practice]"
    ],
    "markers": [
      "★",
      "[["
    ],
    "menu": [
      "Run it now",
      "Refine",
      "Save to file"
    ],
    "replyLine": [
      "Reply `ok` to accept every ★"
    ]
  },
  "artifacts": {
    "skills/prompt-engine/references/output-format.md": [
